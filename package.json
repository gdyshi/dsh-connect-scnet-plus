{
  "name": "dsh-connect-scnet-plus",
  "displayName": "DSH Connect SCNet",
  "description": "把本机 scnet 客户端的模型网关接入 DSH：只读发现凭据，模型目录自动加载。增强版——插件详情页提供模型开关 tab、逐模型启用/停用、诊断与图片历史支持。",
  "version": "0.1.0",
  "author": "dsh-connect-scnet-plus contributors",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "scnet",
    "scnet-client",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "bin": {
    "dsh-connect-scnet-plus": "lib/bin.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/selftest.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": ">=0.87.0 <0.88.0 || >=1.0.0-0 <2.0.0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
